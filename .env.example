# Required
ADMIN_PASSWORD=change-me-to-something-long
# Generate with: openssl rand -hex 32
SESSION_SECRET=
PUBLIC_URL=http://localhost:3060

# Optional
PORT=3060
# Shown to agents in tool descriptions, e.g. "Sam". Defaults to "the reviewer".
REVIEWER_NAME=
# Where the SQLite database and uploads live. Defaults to ./data
DATA_DIR=
# Signs decision callbacks (header x-approvals-signature: sha256=<hmac of body>)
WEBHOOK_SECRET=
# Ping a Discord channel whenever an agent submits something
DISCORD_WEBHOOK_URL=
MAX_UPLOAD_MB=50
